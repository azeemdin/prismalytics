# prismalytics API - Environment Variables
# Copy this file to .env.local and fill in your values

# â”€â”€â”€ Server â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NODE_ENV=development
PORT=3000

# â”€â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# DB_TYPE: sqlite (default) or postgres
# SQLite zero config, stores data in a single file
DB_TYPE=sqlite
DB_PATH=/data/prismalytics.db

# PostgreSQL uncomment and set DB_TYPE=postgres to use instead
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=prismalytics
# DB_PASSWORD=prismalytics_dev_password
# DB_DATABASE=prismalytics

# â”€â”€â”€ Redis â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REDIS_HOST=localhost
REDIS_PORT=6379

# â”€â”€â”€ JWT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# â”€â”€â”€ Data Encryption â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# 32-byte key used to encrypt datasource passwords and AI API keys at rest
# Generate with: openssl rand -hex 16
# ENCRYPTION_KEY=prismalytics-default-enc-key-32byt

# â”€â”€â”€ Keycloak (OIDC optional, leave blank to use local JWT auth) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=prismalytics
# KEYCLOAK_CLIENT_ID=prismalytics-app
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=http://localhost:5173/auth/callback

# â”€â”€â”€ AI / LLM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Provider tried first when a BYOK key is not configured per-tenant.
# Values: gemini | claude | openrouter
AI_DEFAULT_PROVIDER=gemini

# Google Gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash-latest

# Anthropic Claude
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# OpenRouter (supports 100+ models via a single key)
# See https://openrouter.ai/models for available model IDs
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama (self-hosted, no API key required must be reachable from the API server)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# â”€â”€â”€ SMTP (for scheduled-job email notifications) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@example.com
# SMTP_PASS=
# SMTP_FROM=prismalytics <notifications@example.com>

# â”€â”€â”€ CORS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CORS_ORIGIN=http://localhost:5173
