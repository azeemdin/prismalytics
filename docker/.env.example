# Host port the web UI is accessible on (maps to nginx port 8080 inside)
WEB_PORT=80

# â”€â”€â”€ PostgreSQL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
POSTGRES_USER=prismalytics
POSTGRES_PASSWORD=prismalytics_password
POSTGRES_DB=prismalytics

# Set to false once the schema is stable to prevent automatic migrations on start
DB_SYNCHRONIZE=true

# â”€â”€â”€ Auth (REQUIRED) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-secret

JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# 32-byte key used to encrypt datasource credentials and AI API keys at rest.
# Generate: openssl rand -hex 16
ENCRYPTION_KEY=

# â”€â”€â”€ CORS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Public URL users access the web UI on (used by the API for CORS)
CORS_ORIGIN=http://localhost

# â”€â”€â”€ AI / LLM (at least one key required for AI features) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
AI_DEFAULT_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# Anthropic Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# OpenRouter (100+ models via a single key https://openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama (self-hosted, no key required must be reachable from the API container)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# â”€â”€â”€ SMTP (optional for scheduled-job email notifications) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=prismalytics <notifications@example.com>
